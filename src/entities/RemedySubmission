{
  "name": "RemedySubmission",
  "type": "object",
  "properties": {
    "herbs_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of herbs used in the remedy"
    },
    "health_condition": {
      "type": "string",
      "description": "Health condition being addressed"
    },
    "preparation_method": {
      "type": "string",
      "description": "How the remedy was prepared"
    },
    "dosage": {
      "type": "string",
      "description": "Dosage used"
    },
    "duration_of_use": {
      "type": "string",
      "description": "How long the remedy was used"
    },
    "observed_effects": {
      "type": "string",
      "description": "Effects observed from using the remedy"
    },
    "submitter_name": {
      "type": "string",
      "description": "Optional name of person submitting"
    },
    "submitter_contact": {
      "type": "string",
      "description": "Optional contact information"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "Pending Review",
        "Approved",
        "Flagged - Risk Identified",
        "Rejected"
      ],
      "default": "Pending Review",
      "description": "AI moderation status"
    },
    "ai_feedback": {
      "type": "string",
      "description": "AI moderation feedback and analysis"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "Low",
        "Moderate",
        "High",
        "Critical"
      ],
      "description": "AI-assessed risk level"
    },
    "expert_review_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether expert review is needed"
    }
  },
  "required": [
    "herbs_used",
    "health_condition",
    "preparation_method",
    "observed_effects"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}