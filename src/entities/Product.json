{
  "name": "Product",
  "type": "object",
  "properties": {
    "product_name": {
      "type": "string",
      "description": "Name of the product"
    },
    "description": {
      "type": "string",
      "description": "Detailed product description, ingredients"
    },
    "seller_id": {
      "type": "string",
      "description": "Reference to SellerProfile.id"
    },
    "seller_business_name": {
      "type": "string",
      "description": "Cached seller business name for easy display"
    },
    "price": {
      "type": "number",
      "description": "Product price"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code (e.g., USD, ZAR, EUR)"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Multiple images of the product"
    },
    "purchase_url": {
      "type": "string",
      "description": "Direct link where users can buy the product"
    },
    "linked_remedy_id": {
      "type": "string",
      "description": "Reference to Remedy.id - connects product to a remedy"
    },
    "linked_remedy_name": {
      "type": "string",
      "description": "Cached remedy name for easy display"
    },
    "linked_herbs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Herbs used in this product"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "Tincture",
        "Tea Blend",
        "Salve",
        "Capsules",
        "Extract",
        "Powder",
        "Oil",
        "Cream",
        "Other"
      ],
      "description": "Type of herbal product"
    },
    "size": {
      "type": "string",
      "description": "Product size/quantity (e.g., '100ml', '60 capsules')"
    },
    "availability": {
      "type": "boolean",
      "default": true,
      "description": "Is the product currently in stock/available"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "description": "Moderation status for the product listing"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether to feature this product"
    }
  },
  "required": [
    "product_name",
    "description",
    "seller_id",
    "price",
    "product_type"
  ]
}