{
  "name": "Remedy",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the remedy (e.g., 'Chamomile Tea for Insomnia')"
    },
    "description": {
      "type": "string",
      "description": "Detailed explanation of the remedy"
    },
    "primary_herb_id": {
      "type": "string",
      "description": "The main herb used in this remedy (reference to Herb.id)"
    },
    "primary_herb_name": {
      "type": "string",
      "description": "Name of the primary herb for easy reference"
    },
    "herbs_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other herbs involved in the remedy"
    },
    "health_condition": {
      "type": "string",
      "description": "The ailment/symptom this remedy addresses"
    },
    "conditions_treated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional health conditions this remedy can address"
    },
    "preparation_method": {
      "type": "string",
      "description": "Detailed instructions on how to prepare the remedy"
    },
    "dosage": {
      "type": "string",
      "description": "Recommended dosage for this specific remedy"
    },
    "duration_of_use": {
      "type": "string",
      "description": "How long to use the remedy"
    },
    "observed_effects": {
      "type": "string",
      "description": "Expected outcomes from using this remedy"
    },
    "risk_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Remedy-specific warnings"
    },
    "drug_interactions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known drug interactions for this remedy"
    },
    "contraindications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "When not to use this remedy"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Potential side effects of this remedy"
    },
    "safety_rating": {
      "type": "string",
      "enum": [
        "Generally Safe",
        "Use with Caution",
        "High Risk - Expert Guidance Required"
      ],
      "default": "Use with Caution",
      "description": "Safety rating specific to this remedy"
    },
    "category": {
      "type": "string",
      "enum": [
        "Adaptogen",
        "Anti-inflammatory",
        "Digestive",
        "Immune Support",
        "Cardiovascular",
        "Respiratory",
        "Nervous System",
        "Antimicrobial",
        "Pain Relief",
        "Skin Health",
        "Other"
      ],
      "description": "Primary category of this remedy"
    },
    "region": {
      "type": "string",
      "enum": [
        "Africa",
        "Asia",
        "Europe",
        "North America",
        "South America",
        "Australia",
        "Middle East",
        "Global"
      ],
      "description": "Region where this remedy originates"
    },
    "research_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "description": "Scientific research references for this remedy"
    },
    "image_url": {
      "type": "string",
      "description": "Image representing the remedy"
    },
    "submitted_by": {
      "type": "string",
      "description": "Name of person who submitted this remedy"
    },
    "approved_by_ai": {
      "type": "boolean",
      "default": false,
      "description": "Was it AI-approved for publication"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "To feature this remedy on the homepage"
    }
  },
  "required": [
    "name",
    "description",
    "primary_herb_name",
    "health_condition",
    "preparation_method"
  ]
}