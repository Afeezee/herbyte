{
  "name": "Herb",
  "type": "object",
  "properties": {
    "common_name": {
      "type": "string",
      "description": "Common name of the herb"
    },
    "botanical_name": {
      "type": "string",
      "description": "Scientific botanical name"
    },
    "local_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Local or regional names"
    },
    "description": {
      "type": "string",
      "description": "General description of the herb"
    },
    "image_url": {
      "type": "string",
      "description": "URL to herb image"
    },
    "region": {
      "type": "string",
      "enum": [
        "Africa",
        "Asia",
        "Europe",
        "North America",
        "South America",
        "Australia",
        "Middle East",
        "Global"
      ],
      "description": "Primary region where herb is found"
    },
    "category": {
      "type": "string",
      "enum": [
        "Adaptogen",
        "Anti-inflammatory",
        "Digestive",
        "Immune Support",
        "Cardiovascular",
        "Respiratory",
        "Nervous System",
        "Antimicrobial",
        "Pain Relief",
        "Skin Health",
        "Other"
      ],
      "description": "Primary herbal category"
    },
    "health_benefits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "benefit": {
            "type": "string"
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "Strong Clinical Evidence",
              "Moderate Evidence",
              "Preliminary Research",
              "Traditional Use",
              "Anecdotal"
            ]
          }
        }
      },
      "description": "Health benefits with evidence levels"
    },
    "conditions_treated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Health conditions this herb addresses"
    },
    "preparation_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "instructions": {
            "type": "string"
          }
        }
      },
      "description": "How to prepare the herb"
    },
    "dosage": {
      "type": "string",
      "description": "Recommended dosage"
    },
    "drug_interactions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Known drug interactions"
    },
    "contraindications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "When not to use this herb"
    },
    "side_effects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Potential side effects"
    },
    "major_compounds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key chemical compounds"
    },
    "research_references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "description": "Scientific research references"
    },
    "safety_rating": {
      "type": "string",
      "enum": [
        "Generally Safe",
        "Use with Caution",
        "High Risk - Expert Guidance Required"
      ],
      "description": "Overall safety rating"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether to feature on homepage"
    }
  },
  "required": [
    "common_name",
    "botanical_name",
    "description",
    "category",
    "region"
  ]
}