{
  "name": "Wishlist",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who saved this item"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Herb",
        "Remedy",
        "Product",
        "Event"
      ],
      "description": "Type of entity saved"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the saved entity"
    },
    "entity_name": {
      "type": "string",
      "description": "Name of the entity for easy display"
    },
    "entity_image_url": {
      "type": "string",
      "description": "Image URL for thumbnail"
    },
    "entity_metadata": {
      "type": "object",
      "description": "Additional metadata about the entity"
    }
  },
  "required": [
    "user_email",
    "entity_type",
    "entity_id",
    "entity_name"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}