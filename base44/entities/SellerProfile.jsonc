{
  "name": "SellerProfile",
  "type": "object",
  "properties": {
    "business_name": {
      "type": "string",
      "description": "Name of the business/practice"
    },
    "contact_email": {
      "type": "string",
      "format": "email",
      "description": "Public contact email"
    },
    "phone_number": {
      "type": "string",
      "description": "Contact phone number"
    },
    "website_url": {
      "type": "string",
      "description": "Link to their own website/store"
    },
    "description": {
      "type": "string",
      "description": "About their practice/products"
    },
    "logo_url": {
      "type": "string",
      "description": "Link to their business logo"
    },
    "location": {
      "type": "string",
      "description": "Physical location or service area"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Professional certifications (e.g., 'Certified Herbalist')"
    },
    "specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Areas of specialty"
    },
    "years_in_practice": {
      "type": "number",
      "description": "Years of experience"
    },
    "terms_accepted": {
      "type": "boolean",
      "default": false,
      "description": "Agreement to platform terms"
    },
    "moderation_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Approved",
        "Rejected"
      ],
      "default": "Pending",
      "description": "Moderation status for the seller profile"
    }
  },
  "required": [
    "business_name",
    "contact_email",
    "description"
  ],
  "rls": {
    "create": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}