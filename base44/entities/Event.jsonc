{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Event title"
    },
    "description": {
      "type": "string",
      "description": "Detailed event description"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "Workshop",
        "Webinar",
        "Conference",
        "Community Gathering",
        "Plant Walk",
        "Wellness Fair",
        "Education Session",
        "Other"
      ],
      "description": "Type of event"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Event date"
    },
    "start_time": {
      "type": "string",
      "description": "Event start time"
    },
    "end_time": {
      "type": "string",
      "description": "Event end time"
    },
    "location_type": {
      "type": "string",
      "enum": [
        "In-Person",
        "Virtual",
        "Hybrid"
      ],
      "description": "Location type"
    },
    "location_address": {
      "type": "string",
      "description": "Physical address or virtual meeting link"
    },
    "city": {
      "type": "string",
      "description": "City"
    },
    "country": {
      "type": "string",
      "description": "Country"
    },
    "organizer_name": {
      "type": "string",
      "description": "Name of the organizer"
    },
    "organizer_email": {
      "type": "string",
      "format": "email",
      "description": "Organizer contact email"
    },
    "organizer_phone": {
      "type": "string",
      "description": "Organizer contact phone"
    },
    "image_url": {
      "type": "string",
      "description": "Event banner/poster image"
    },
    "max_attendees": {
      "type": "number",
      "description": "Maximum number of attendees (optional)"
    },
    "registration_required": {
      "type": "boolean",
      "default": false,
      "description": "Whether registration is required"
    },
    "registration_link": {
      "type": "string",
      "description": "External registration link"
    },
    "is_free": {
      "type": "boolean",
      "default": true,
      "description": "Whether the event is free"
    },
    "price": {
      "type": "number",
      "description": "Event price if not free"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency for paid events"
    },
    "topics_covered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Topics/herbs covered in the event"
    },
    "benefits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Benefits of attending"
    },
    "target_audience": {
      "type": "string",
      "description": "Who should attend"
    },
    "status": {
      "type": "string",
      "enum": [
        "Upcoming",
        "Ongoing",
        "Completed",
        "Cancelled"
      ],
      "default": "Upcoming",
      "description": "Event status"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Whether to feature on homepage"
    }
  },
  "required": [
    "title",
    "description",
    "event_type",
    "date",
    "start_time",
    "location_type",
    "organizer_name",
    "organizer_email"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}