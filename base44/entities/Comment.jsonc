{
  "name": "Comment",
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "description": "Comment text content"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the user who commented"
    },
    "author_name": {
      "type": "string",
      "description": "Name of the user who commented"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "Herb",
        "Remedy",
        "Product",
        "Event"
      ],
      "description": "Type of entity being commented on"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity being commented on"
    },
    "entity_name": {
      "type": "string",
      "description": "Name of the entity for easy display"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "ID of parent comment if this is a reply"
    },
    "reply_count": {
      "type": "number",
      "default": 0,
      "description": "Number of replies to this comment"
    }
  },
  "required": [
    "content",
    "author_email",
    "author_name",
    "entity_type",
    "entity_id"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}